{
  "info": {
    "name": "Franquicia API - rutas explicitas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Flujo principal (ejecutar en orden)",
      "item": [
        {
          "name": "01 Crear franquicia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/franquicias/crear",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Franquicia Centro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Estado consistente\", () => pm.expect(pm.response.json().status).to.eql(pm.response.code));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"franquicia_id\", pm.response.json().data.id);",
                  "pm.test(\"Recurso identificado\", () => { const d = pm.response.json().data; pm.expect(d.id).to.be.a(\"number\"); pm.expect(d.nombre).to.be.a(\"string\"); pm.expect(d.message).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
